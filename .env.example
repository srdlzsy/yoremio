ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=yoremio;Username=postgres;Password=CHANGE_ME
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__Issuer=yoremio-api
Jwt__Audience=yoremio-client
Jwt__ExpireMinutes=60
Startup__ApplyMigrations=true
Startup__SeedSampleData=true
Verification__PublicBaseUrl=http://localhost:5089
Verification__RequireConfirmedEmailForSellerLogin=true

# Email dogrulama icin ucretsiz kotali SMTP secenekleri:
# Brevo: Host=smtp-relay.brevo.com, UserName=Brevo SMTP login, Password=Brevo SMTP key
# Resend: Host=smtp.resend.com, UserName=resend, Password=Resend API key
Email__Smtp__UseMockSender=false
Email__Smtp__Provider=Brevo
Email__Smtp__Host=smtp-relay.brevo.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__UserName=CHANGE_ME_BREVO_SMTP_LOGIN_OR_resend
Email__Smtp__Password=CHANGE_ME_SMTP_KEY
Email__Smtp__FromAddress=no-reply@yoremio.com
Email__Smtp__FromName=Yoremio
Cloudinary__Enabled=false
Cloudinary__CloudName=CHANGE_ME
Cloudinary__ApiKey=CHANGE_ME
Cloudinary__ApiSecret=CHANGE_ME
Cloudinary__UploadFolder=yoremio
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://localhost:5173
Cors__AllowedOrigins__2=http://localhost:3000
Cors__AllowedOrigins__3=https://localhost:3000
Cors__AllowedOrigins__4=https://yoremio.vercel.app
Cors__AllowedOrigins__5=https://www.yoremio.com
Cors__AllowedOrigins__6=https://yoremio.com
Cors__AllowedVercelPreviewHostSuffixes__0=-serdals-projects-e9817ac1.vercel.app
